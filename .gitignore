# Credentials — never commit these
profiles.yml
.env
*.pem
*.p8
*.key
# JSON added 2026-08-31: the BigQuery service-account key is a .json, and the
# patterns above only ever covered the Snowflake .p8/.pem formats. Deliberately
# specific rather than a blanket *.json, which would hide legitimate config.
keys/
bq_dbt_sa.json
*service-account*.json
*serviceaccount*.json
*credentials*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local scratch — throwaway files for trying things out, not part of the project
analysis/test.sql

# Coaching ledger — private review notes, not part of the learning log
notes/.coach-ledger.md

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
